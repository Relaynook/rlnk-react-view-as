{
  "name": "@relaynook/react-view-as",
  "version": "0.1.1",
  "description": "Role view-as (act-as) system for React admin SPAs — Zustand store + hook + dropdown UI, generic over your role type.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=18",
    "zustand": ">=4"
  },
  "devDependencies": {
    "@types/react": "^18",
    "react": "^18",
    "tsup": "^8.3.5",
    "typescript": "^5",
    "zustand": "^5"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Relaynook/rlnk-react-view-as.git"
  },
  "keywords": [
    "react",
    "view-as",
    "act-as",
    "role",
    "permissions",
    "zustand",
    "admin",
    "rbac"
  ],
  "author": "Relaynook",
  "license": "MIT"
}
